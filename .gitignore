# ==============================================================================
# CONFIDENTIAL & SENSITIVE FILES (DO NOT COMMIT)
# ==============================================================================
# Environment variables containing database connection strings, JWT secrets, API keys
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
# Whitelist example template so other developers know which keys to configure
!.env.example

# Private cryptographic keys, certificates & keystores
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore
*.cer
*.der

# API & Cloud credentials (Google Cloud, AWS, Firebase, OAuth, Service Accounts)
credentials.json
client_secret*.json
service-account*.json
token.json
google-services.json
firebase-adminsdk*.json
aws-credentials
.aws/

# SSH private keys
id_rsa
id_rsa*
id_ecdsa
id_ed25519
*.ppk

# Database dumps, backups & local SQLite files
*.sql
*.sql.gz
*.dump
*.bak
*.backup
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
*.db-journal
prisma/*.db
prisma/*.sqlite

# Local user uploads, resumes, attachments & media
uploads/
public/uploads/
storage/
media/
downloads/

# ==============================================================================
# DEPENDENCIES & PACKAGE MANAGERS
# ==============================================================================
node_modules/
.pnpm-store/
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.yarn-integrity

# ==============================================================================
# PRODUCTION BUILDS & RUNTIME ARTIFACTS
# ==============================================================================
.next/
out/
build/
dist/
.swc/

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# ==============================================================================
# LOGS, DEBUGGING & DIAGNOSTICS
# ==============================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ==============================================================================
# TEST COVERAGE & PROFILING
# ==============================================================================
coverage/
.nyc_output/
.clinic/
.turbo/

# ==============================================================================
# IDE, EDITORS & SYSTEM ARTIFACTS
# ==============================================================================
