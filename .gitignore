.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Temporary & Scratch Files
tmp/
temp/
scratch/
scratch_*
*.tmp
*.temp
.tempmediaStorage/
.system_generated/
